<file path=".github/workflows/deploy.yml">
 1: name: Deploy to GitHub Pages
 2: 
 3: on:
 4:   push:
 5:     branches: ["main"]
 6:   workflow_dispatch:
 7: 
 8: # Permisos requeridos a nivel global para GitHub Pages
 9: permissions:
10:   contents: read
11:   pages: write
12:   id-token: write
13: 
14: # Cancela ejecuciones anteriores si haces varios pushes seguidos
15: concurrency:
16:   group: "pages"
17:   cancel-in-progress: true
18: 
19: jobs:
20:   # 1. Job para instalar y compilar el proyecto
21:   build:
22:     runs-on: ubuntu-latest
23:     steps:
24:       - uses: actions/checkout@v4
25: 
26:       - name: Setup Node
27:         uses: actions/setup-node@v4
28:         with:
29:           node-version: '20'
30: 
31:       - name: Install dependencies
32:         working-directory: frontend
33:         run: npm install
34: 
35:       - name: Build
36:         working-directory: frontend
37:         env:
38:           VITE_API_URL: ${{ vars.VITE_API_URL}}
39:         run: npm run build
40: 
41:       - name: Setup Pages
42:         uses: actions/configure-pages@v5
43: 
44:       - name: Upload artifact
45:         uses: actions/upload-pages-artifact@v3
46:         with:
47:           path: './frontend/dist'
48: 
49:   # 2. Job para publicar el artefacto en GitHub Pages
50:   deploy:
51:     environment:
52:       name: github-pages
53:       url: ${{ steps.deployment.outputs.page_url }}
54:     runs-on: ubuntu-latest
55:     needs: build
56:     steps:
57:       - name: Deploy to GitHub Pages
58:         id: deployment
59:         uses: actions/deploy-pages@v5
</file>

