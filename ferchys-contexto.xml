<file path="start-backend.sh">
  1: #!/usr/bin/env bash
  2: 
  3: # Servidor temporal de Ferchy's Postres para Ubuntu dentro de proot-distro.
  4: # Uso: ./start-backend.sh
  5: 
  6: set -u
  7: 
  8: PROJECT_DIR="${PROJECT_DIR:-$HOME/proyectos/WEB-FERCHYS}"
  9: BACKEND_DIR="$PROJECT_DIR/backend"
 10: BACKEND_PORT=8000
 11: NGROK_API="http://127.0.0.1:4040/api/tunnels"
 12: MARIADB_HOST=127.0.0.1
 13: MARIADB_PORT=3306
 14: GITHUB_REPO="${GITHUB_REPO:-ANDREDAR63/WEB-FERCHYS}"
 15: GITHUB_WORKFLOW="${GITHUB_WORKFLOW_FILE:-deploy.yml}"
 16: AUTO_UPDATE_GITHUB="${AUTO_UPDATE_GITHUB:-1}"
 17: 
 18: BACKEND_PID=""
 19: NGROK_PID=""
 20: MARIADB_PID=""
 21: MARIADB_STARTED_BY_SCRIPT=0
 22: 
 23: limpiar() {
 24:     trap - INT TERM EXIT
 25:     echo
 26:     echo "==> Deteniendo servicios..."
 27: 
 28:     if [[ -n "$NGROK_PID" ]] && kill -0 "$NGROK_PID" 2>/dev/null; then
 29:         kill "$NGROK_PID" 2>/dev/null || true
 30:     fi
 31: 
 32:     if [[ -n "$BACKEND_PID" ]] && kill -0 "$BACKEND_PID" 2>/dev/null; then
 33:         kill "$BACKEND_PID" 2>/dev/null || true
 34:     fi
 35: 
 36:     wait "$NGROK_PID" "$BACKEND_PID" 2>/dev/null || true
 37: 
 38:     # Solo detiene MariaDB si este script fue quien la arrancó.
 39:     if [[ "$MARIADB_STARTED_BY_SCRIPT" -eq 1 ]]; then
 40:         if [[ -n "$MARIADB_PID" ]] && kill -0 "$MARIADB_PID" 2>/dev/null; then
 41:             echo "==> Deteniendo MariaDB (iniciada por este script)..."
 42:             if command -v mariadb-admin >/dev/null 2>&1; then
 43:                 mariadb-admin --protocol=tcp -h "$MARIADB_HOST" -P "$MARIADB_PORT" shutdown 2>/dev/null || true
 44:             fi
 45:             kill "$MARIADB_PID" 2>/dev/null || true
 46:             wait "$MARIADB_PID" 2>/dev/null || true
 47:         fi
 48:     else
 49:         echo "==> MariaDB ya estaba corriendo antes; se deja activa."
 50:     fi
 51: 
 52:     echo "==> Servicios detenidos."
 53: }
 54: 
 55: trap limpiar INT TERM EXIT
 56: 
 57: if [[ ! -d "$BACKEND_DIR" ]]; then
 58:     echo "Error: no existe el backend en $BACKEND_DIR" >&2
 59:     exit 1
 60: fi
 61: 
 62: if ! command -v php >/dev/null 2>&1; then
 63:     echo "Error: php no está instalado o no está en PATH." >&2
 64:     exit 1
 65: fi
 66: 
 67: if ! command -v ngrok >/dev/null 2>&1; then
 68:     echo "Error: ngrok no está instalado o no está en PATH." >&2
 69:     exit 1
 70: fi
 71: 
 72: if ! ngrok version >/dev/null 2>&1; then
 73:     echo "Error: ngrok no puede ejecutarse en este Ubuntu/proot." >&2
 74:     echo "Instala dentro de Ubuntu un binario Linux ARM64 de ngrok; no uses el binario de Termux." >&2
 75:     exit 1
 76: fi
 77: 
 78: # Inicia MariaDB sin depender de systemd ni de sudo.
 79: echo "==> Comprobando MariaDB..."
 80: if command -v mariadb-admin >/dev/null 2>&1 && mariadb-admin --protocol=tcp -h "$MARIADB_HOST" -P "$MARIADB_PORT" ping --silent >/dev/null 2>&1; then
 81:     echo "    MariaDB ya está corriendo."
 82: elif command -v service >/dev/null 2>&1 && timeout 5 service mariadb start >/dev/null 2>&1; then
 83:     echo "    MariaDB iniciada mediante service."
 84:     MARIADB_STARTED_BY_SCRIPT=1
 85: elif command -v mariadbd-safe >/dev/null 2>&1; then
 86:     echo "    Iniciando MariaDB mediante mariadbd-safe..."
 87:     mariadbd-safe --skip-networking=0 >/tmp/ferchys-mariadb.log 2>&1 &
 88:     MARIADB_PID=$!
 89:     MARIADB_STARTED_BY_SCRIPT=1
 90:     for _ in $(seq 1 15); do
 91:         if mariadb-admin --protocol=tcp -h "$MARIADB_HOST" -P "$MARIADB_PORT" ping --silent >/dev/null 2>&1; then
 92:             break
 93:         fi
 94:         sleep 1
 95:     done
 96:     if ! mariadb-admin --protocol=tcp -h "$MARIADB_HOST" -P "$MARIADB_PORT" ping --silent >/dev/null 2>&1; then
 97:         echo "Error: MariaDB no respondió. Revisa /tmp/ferchys-mariadb.log" >&2
 98:         exit 1
 99:     fi
100: else
101:     echo "Error: no se encontró una forma de iniciar MariaDB." >&2
102:     exit 1
103: fi
104: 
105: # Libera únicamente los procesos que ocupan el puerto del backend.
106: if command -v lsof >/dev/null 2>&1; then
107:     PIDS=$(lsof -tiTCP:"$BACKEND_PORT" -sTCP:LISTEN 2>/dev/null || true)
108:     if [[ -n "$PIDS" ]]; then
109:         echo "==> Liberando el puerto $BACKEND_PORT..."
110:         kill $PIDS 2>/dev/null || true
111:         sleep 1
112:     fi
113: fi
114: 
115: if command -v fuser >/dev/null 2>&1 && fuser -s "$BACKEND_PORT/tcp" 2>/dev/null; then
116:     echo "==> Forzando la liberación del puerto $BACKEND_PORT..."
117:     fuser -k "$BACKEND_PORT/tcp" >/dev/null 2>&1 || true
118:     sleep 1
119: fi
120: 
121: if command -v lsof >/dev/null 2>&1 && lsof -tiTCP:"$BACKEND_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
122:     echo "Error: el puerto $BACKEND_PORT sigue ocupado y no se pudo liberar." >&2
123:     exit 1
124: fi
125: 
126: echo "==> Iniciando Laravel en el puerto $BACKEND_PORT..."
127: (
128:     cd "$BACKEND_DIR" && exec php artisan serve --host=0.0.0.0 --port="$BACKEND_PORT"
129: ) > /tmp/ferchys-laravel.log 2>&1 &
130: BACKEND_PID=$!
131: 
132: for _ in $(seq 1 15); do
133:     if curl -fsS "http://127.0.0.1:$BACKEND_PORT/up" >/dev/null 2>&1; then
134:         break
135:     fi
136:     sleep 1
137: done
138: 
139: if ! kill -0 "$BACKEND_PID" 2>/dev/null; then
140:     echo "Error: Laravel no pudo iniciarse. Revisa /tmp/ferchys-laravel.log" >&2
141:     exit 1
142: fi
143: 
144: if ! curl -fsS "http://127.0.0.1:$BACKEND_PORT/up" >/dev/null 2>&1; then
145:     echo "Error: Laravel no responde en el puerto $BACKEND_PORT. Revisa /tmp/ferchys-laravel.log" >&2
146:     exit 1
147: fi
148: 
149: echo "==> Iniciando ngrok..."
150: ngrok http "$BACKEND_PORT" --log=stdout > /tmp/ferchys-ngrok.log 2>&1 &
151: NGROK_PID=$!
152: 
153: PUBLIC_URL=""
154: for _ in $(seq 1 20); do
155:     TUNNELS=$(curl -fsS "$NGROK_API" 2>/dev/null || true)
156:     PUBLIC_URL=$(printf '%s' "$TUNNELS" | sed -nE 's/.*"public_url":"(https:[^"]+)".*/\1/p' | head -n 1)
157:     if [[ -n "$PUBLIC_URL" ]]; then
158:         break
159:     fi
160:     sleep 1
161: done
162: 
163: if [[ -z "$PUBLIC_URL" ]]; then
164:     echo "Error: ngrok no expuso una URL. Revisa /tmp/ferchys-ngrok.log" >&2
165:     exit 1
166: fi
167: 
168: API_URL="$PUBLIC_URL/api"
169: 
170: echo
171: echo "Backend local: http://127.0.0.1:$BACKEND_PORT"
172: echo "API pública:  $API_URL"
173: echo "URL pública:  $PUBLIC_URL"
174: echo
175: 
176: if [[ "$AUTO_UPDATE_GITHUB" -eq 1 ]]; then
177:     if ! command -v gh >/dev/null 2>&1; then
178:         echo "Aviso: gh no está instalado, no se puede actualizar GitHub automáticamente." >&2
179:         echo "Actualiza manualmente VITE_API_URL con el valor: $API_URL" >&2
180:     elif ! gh auth status >/dev/null 2>&1; then
181:         echo "Aviso: gh no está autenticado, no se puede actualizar GitHub automáticamente." >&2
182:         echo "Actualiza manualmente VITE_API_URL con el valor: $API_URL" >&2
183:     else
184:         echo "==> Actualizando VITE_API_URL en GitHub ($GITHUB_REPO)..."
185:         if gh variable set VITE_API_URL --repo "$GITHUB_REPO" --body "$API_URL"; then
186:             echo "    Variable actualizada."
187:             echo "==> Disparando el workflow $GITHUB_WORKFLOW..."
188:             if gh workflow run "$GITHUB_WORKFLOW" --repo "$GITHUB_REPO"; then
189:                 echo "    Workflow disparado. Sigue el progreso con:"
190:                 echo "    gh run watch --repo $GITHUB_REPO"
191:             else
192:                 echo "Aviso: no se pudo disparar el workflow automáticamente." >&2
193:                 echo "Ejecuta manualmente: gh workflow run $GITHUB_WORKFLOW --repo $GITHUB_REPO" >&2
194:             fi
195:         else
196:             echo "Aviso: no se pudo actualizar la variable en GitHub." >&2
197:             echo "Actualiza manualmente VITE_API_URL con el valor: $API_URL" >&2
198:         fi
199:     fi
200: else
201:     echo "Actualiza VITE_API_URL en GitHub:"
202:     echo "Settings -> Secrets and variables -> Actions -> Variables"
203:     echo "Valor: $API_URL"
204: fi
205: 
206: echo
207: echo "La URL cambia cuando reinicias ngrok con el plan gratuito."
208: echo
209: echo "Presiona Ctrl+C para detener Laravel y ngrok."
210: 
211: # Mantiene el script en primer plano mientras ambos procesos siguen vivos.
212: while kill -0 "$BACKEND_PID" 2>/dev/null && kill -0 "$NGROK_PID" 2>/dev/null; do
213:     sleep 2
214: done
215: 
216: if ! kill -0 "$BACKEND_PID" 2>/dev/null; then
217:     echo "Laravel terminó. Revisa /tmp/ferchys-laravel.log" >&2
218: else
219:     echo "ngrok terminó. Revisa /tmp/ferchys-ngrok.log" >&2
220: fi
221: exit 1
</file>

