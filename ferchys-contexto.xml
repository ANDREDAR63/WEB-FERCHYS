173: 
174:             <label htmlFor="clave">
175:               Contraseña: <span className="campo-obligatorio">*</span>
176:             </label>
177:             <input
178:               type="password"
179:               id="clave"
180:               name="clave"
181:               placeholder="Mínimo 8 caracteres (mayúscula, minúscula, número y símbolo)"
182:               value={formData.clave}
183:               onChange={handleChange}
184:               required
185:             />
186: 
187:             <label htmlFor="confirmarClave">
