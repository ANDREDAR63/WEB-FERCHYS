<file path="backend/app/Http/Controllers/Api/PaymentController.php">
 1: <?php
 2: 
 3: namespace App\Http\Controllers\Api;
 4: 
 5: use App\Http\Controllers\Controller;
 6: use App\Models\Order;
 7: use App\Models\Payment;
 8: use Illuminate\Http\Request;
 9: use Illuminate\Support\Facades\DB;
10: use Illuminate\Validation\ValidationException;
11: 
12: class PaymentController extends Controller
13: {
14:     public function index()
15:     {
16:         return Payment::with(['order.user', 'paymentMethod'])
17:             ->latest('paid_at')
18:             ->get();
19:     }
20: 
21:     public function store(Request $request, Order $order)
22:     {
23:         if ($order->user_id !== $request->user()->id) {
24:             abort(403, 'No tienes permiso sobre este pedido.');
25:         }
26: 
27:         $validated = $request->validate([
28:             'payment_method_id' => 'required|exists:payment_methods,id',
29:         ]);
30: 
31:         if ($order->payments()->where('status', 'approved')->exists()) {
32:             throw ValidationException::withMessages([
33:                 'order' => ['Este pedido ya tiene un pago aprobado.'],
34:             ]);
35:         }
36: 
37:         $payment = DB::transaction(function () use ($order, $validated) {
38:             $payment = Payment::create([
39:                 'order_id' => $order->id,
40:                 'payment_method_id' => $validated['payment_method_id'],
41:                 'amount' => $order->total,
42:                 'status' => 'approved',
43:             ]);
44: 
45:             $order->update(['status' => 'preparing']);
46: 
47:             $order->statusHistory()->create([
48:                 'previous_status' => 'pending',
49:                 'new_status' => 'preparing',
50:             ]);
51: 
52:             return $payment;
53:         });
54: 
55:         return response()->json($payment->load('paymentMethod'), 201);
56:     }
57: 
58:     public function show(Request $request, Order $order)
59:     {
60:         if ($order->user_id !== $request->user()->id && $request->user()->role !== 'admin') {
61:             abort(403, 'No tienes permiso sobre este pedido.');
62:         }
63: 
64:         return $order->payments()->with('paymentMethod')->get();
65:     }
66: }
</file>

