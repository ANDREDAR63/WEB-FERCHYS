<file path="frontend/src/components/dashboard/CookDashboard.jsx">
  1: import { useEffect, useState } from 'react';
  2: import { apiRequest } from '../../services/api';
  3: import './dashboard.css';
  4: 
  5: const statusLabels = { pending: 'Pendiente', preparing: 'En preparación', shipped: 'Listo para entrega' };
  6: 
  7: function sortOrders(orders) {
  8:   return [...orders].sort((first, second) => new Date(first.created_at) - new Date(second.created_at));
  9: }
 10: 
 11: function formatDate(value) {
 12:   return value ? new Date(value).toLocaleString('es-CO', { dateStyle: 'medium', timeStyle: 'short' }) : 'Sin fecha';
 13: }
 14: 
 15: function getRequirements(order) {
 16:   const requirements = new Map();
 17: 
 18:   order.items?.forEach((item) => {
 19:     item.product?.ingredients?.forEach((ingredient) => {
 20:       const required = Number(ingredient.pivot?.quantity_required || 0) * Number(item.quantity || 0);
 21:       const current = requirements.get(ingredient.id) || {
 22:         id: ingredient.id,
 23:         name: ingredient.name,
 24:         unit: ingredient.unit,
 25:         currentStock: Number(ingredient.current_stock || 0),
 26:         required: 0,
 27:       };
 28:       current.required += required;
 29:       requirements.set(ingredient.id, current);
 30:     });
 31:   });
 32: 
 33:   return [...requirements.values()];
 34: }
 35: 
 36: function isInsufficient(order) {
 37:   return getRequirements(order).some((ingredient) => ingredient.required > ingredient.currentStock);
 38: }
 39: 
 40: export default function CookDashboard() {
 41:   const [orders, setOrders] = useState([]);
 42:   const [ingredients, setIngredients] = useState([]);
 43:   const [error, setError] = useState('');
 44:   const [loadingId, setLoadingId] = useState(null);
 45: 
 46:   async function loadData() {
 47:     try {
 48:       const [orderData, ingredientData] = await Promise.all([apiRequest('/orders'), apiRequest('/ingredients')]);
 49:       setOrders(sortOrders(orderData));
 50:       setIngredients(ingredientData);
 51:       setError('');
 52:     } catch (err) {
 53:       setError(err.message);
 54:     }
 55:   }
 56: 
 57:   useEffect(() => {
 58:     let active = true;
 59:     const refresh = async () => {
 60:       try {
 61:         const [orderData, ingredientData] = await Promise.all([apiRequest('/orders'), apiRequest('/ingredients')]);
 62:         if (!active) return;
 63:         setOrders(sortOrders(orderData));
 64:         setIngredients(ingredientData);
 65:         setError('');
 66:       } catch (err) {
 67:         if (active) setError(err.message);
 68:       }
 69:     };
 70: 
 71:     refresh();
 72:     const interval = setInterval(refresh, 30000);
 73:     return () => { active = false; clearInterval(interval); };
 74:   }, []);
 75: 
 76:   async function updateStatus(order) {
 77:     const nextStatus = order.status === 'pending' ? 'preparing' : 'shipped';
 78:     setLoadingId(order.id);
 79:     try {
 80:       await apiRequest(`/orders/${order.id}/status`, { method: 'PUT', body: JSON.stringify({ status: nextStatus }) });
 81:       await loadData();
 82:     } catch (err) {
 83:       setError(err.message);
 84:     } finally {
 85:       setLoadingId(null);
 86:     }
 87:   }
 88: 
 89:   return (
 90:     <section className="dashboard-page">
 91:       <div className="dashboard-shell">
 92:         <div className="dashboard-heading">
 93:           <div>
 94:             <h1>Cocina</h1>
 95:             <p>Cola de preparación e inventario actualizado.</p>
 96:           </div>
 97:         </div>
 98: 
 99:         {error && <p className="dashboard-error">{error}</p>}
100: 
101:         <section className="dashboard-panel dashboard-section">
102:           <h2>Cola de pedidos</h2>
103:           {orders.length === 0 ? <p className="dashboard-empty">No hay pedidos pagados pendientes de preparación.</p> : (
104:             <div className="dashboard-table-wrap">
105:               <table className="dashboard-table">
