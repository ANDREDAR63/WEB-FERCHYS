115:           precio: Number(product.price),
116:           img: product.image_url || obtenerImagen(imagenesPorProducto[product.name] || 'favicon-rosa'),
117:           badge: '',
118:         })));
119:       })
120:       .catch((requestError) => {
121:         setError(requestError.message);
122:         setProductos(productosIniciales);
123:       });
124:   }, []);
125: 
126:   useEffect(() => {
127:     if (!localStorage.getItem('ferchys-token')) {
128:       return;
129:     }
130:     apiRequest('/cart')
131:       .then((cart) => {
