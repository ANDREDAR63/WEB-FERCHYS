 97:   const [productos, setProductos] = useState([]);
 98:   const [carritoActual, setCarritoActual] = useState(readGuestCart);
 99:   const [error, setError] = useState('');
100:   const navigate = useNavigate();
101:   const { user } = useAuth();
102: 
103:   useEffect(() => {
104:     apiRequest('/products')
105:       .then((data) => {
106:         if (!Array.isArray(data) || data.length === 0) {
107:           setProductos(productosIniciales);
108:           return;
109:         }
110:         setProductos(data.map((product) => ({
111:           ...product,
112:           categoria: product.category?.name?.toLowerCase() || 'otros',
