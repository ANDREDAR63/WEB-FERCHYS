<file path="frontend/src/components/dashboard/ClienteDashboard.jsx">
 1: import { useEffect, useState } from 'react';
 2: import { apiRequest } from '../../services/api';
 3: import ProductPreview from '../catalogo/ProductPreview';
 4: import './dashboard.css';
 5: 
 6: const statusLabels = { pending: 'Pendiente', preparing: 'En preparación', shipped: 'En camino', delivered: 'Entregado', cancelled: 'Cancelado' };
 7: 
 8: function formatDate(value) {
 9:   return value ? new Date(value).toLocaleDateString('es-CO', { dateStyle: 'medium' }) : 'Sin fecha';
10: }
11: 
12: export default function ClienteDashboard() {
13:   const [orders, setOrders] = useState([]);
14:   const [error, setError] = useState('');
15:   const [openProductId, setOpenProductId] = useState(null);
16: 
17:   useEffect(() => {
18:     let active = true;
19:     apiRequest('/orders')
20:       .then((data) => { if (active) setOrders(data); })
21:       .catch((requestError) => { if (active) setError(requestError.message); });
22:     return () => { active = false; };
23:   }, []);
24: 
25:   return (
26:     <section className="dashboard-page client-dashboard">
27:       <div className="dashboard-shell">
28:         <div className="dashboard-heading">
29:           <div><h1>Mis compras</h1><p>Consulta tus pedidos y revisa su estado.</p></div>
30:         </div>
31:         {error && <p className="dashboard-error">{error}</p>}
32:         {orders.length === 0 && !error ? <div className="dashboard-panel dashboard-empty"><p>Aún no tienes pedidos.</p></div> : (
33:           <div className="client-orders">
34:             {orders.map((order) => (
35:               <article className="dashboard-panel client-order" key={order.id}>
36:                 <div className="client-order__header">
37:                   <div><h2>Pedido #{order.id}</h2><p>Realizado el {formatDate(order.created_at)}</p></div>
38:                   <span className="status">{statusLabels[order.status] || order.status}</span>
39:                 </div>
40:                 <div className="client-order__body">
41:                   <div>
42:                     <h3>Productos</h3>
43:                     <ul className="client-order__items">
44:                       {order.items?.map((item) => <li key={item.id}><ProductPreview product={item.product} quantity={item.quantity} open={openProductId === item.id} onToggle={() => setOpenProductId((currentId) => currentId === item.id ? null : item.id)} /><strong>${Number(item.unit_price * item.quantity).toLocaleString()}</strong></li>)}
45:                     </ul>
46:                   </div>
47:                   <div className="client-order__details">
48:                     <p><strong>Total:</strong> ${Number(order.total).toLocaleString()}</p>
49:                     <p><strong>Entrega:</strong> {order.address?.full_address || 'Sin dirección'}</p>
50:                     <p><strong>Pago:</strong> {order.payments?.[0]?.paymentMethod?.name || 'Registrado'}</p>
51:                   </div>
52:                 </div>
53:               </article>
54:             ))}
55:           </div>
56:         )}
57:       </div>
58:     </section>
59:   );
60: }
</file>

<file path="frontend/src/components/dashboard/CourierDashboard.jsx">
 1: import { useEffect, useState } from 'react';
 2: import { apiRequest } from '../../services/api';
 3: import './dashboard.css';
 4: 
 5: function paymentInfo(order) {
 6:   const approved = order.payments?.find((payment) => payment.status === 'approved');
 7:   if (approved) return { label: 'Pagado', detail: approved.paymentMethod?.name || 'Pago aprobado', className: 'dashboard-alert--ok' };
 8:   return { label: 'Cobro contra entrega', detail: 'No hay pago aprobado', className: 'dashboard-alert--critical' };
 9: }
10: 
11: function deliveredAt(order) {
12:   const history = [...(order.statusHistory || [])].reverse().find((item) => item.new_status === 'delivered');
13:   return history?.created_at || null;
14: }
15: 
16: export default function CourierDashboard() {
17:   const [orders, setOrders] = useState([]);
18:   const [error, setError] = useState('');
19:   const [loadingId, setLoadingId] = useState(null);
20:   const [lastDelivered, setLastDelivered] = useState(null);
21: 
22:   async function loadOrders() {
23:     try {
24:       setOrders(await apiRequest('/orders'));
25:       setError('');
26:     } catch (err) {
27:       setError(err.message);
28:     }
29:   }
30: 
31:   useEffect(() => {
32:     let active = true;
33:     const refresh = async () => {
34:       try {
35:         const data = await apiRequest('/orders');
36:         if (active) {
37:           setOrders(data);
38:           setError('');
39:         }
40:       } catch (err) {
41:         if (active) setError(err.message);
42:       }
43:     };
44: 
45:     refresh();
46:     const interval = setInterval(refresh, 30000);
47:     return () => { active = false; clearInterval(interval); };
48:   }, []);
49: 
50:   async function confirmDelivery(order) {
51:     setLoadingId(order.id);
52:     try {
53:       const updatedOrder = await apiRequest(`/orders/${order.id}/status`, { method: 'PUT', body: JSON.stringify({ status: 'delivered' }) });
54:       const deliveredHistory = deliveredAt(updatedOrder) || new Date().toISOString();
55:       setLastDelivered({ id: order.id, at: deliveredHistory });
56:       await loadOrders();
57:     } catch (err) {
58:       setError(err.message);
59:     } finally {
60:       setLoadingId(null);
61:     }
62:   }
63: 
64:   return (
65:     <section className="dashboard-page">
66:       <div className="dashboard-shell">
67:         <div className="dashboard-heading">
68:           <div>
69:             <h1>Repartos</h1>
70:             <p>Pedidos listos para entrega y confirmación de recepción.</p>
71:           </div>
72:         </div>
73: 
74:         {error && <p className="dashboard-error">{error}</p>}
75:         {lastDelivered && <p className="dashboard-confirmation">Pedido #{lastDelivered.id} entregado correctamente a las {new Date(lastDelivered.at).toLocaleString()}.</p>}
76: 
77:         <section className="dashboard-panel dashboard-section">
78:           <h2>Cola de entregas</h2>
79:           {orders.length === 0 ? <p className="dashboard-empty">No hay pedidos listos para entregar.</p> : <div className="dashboard-table-wrap"><table className="dashboard-table"><thead><tr><th>Pedido</th><th>Cliente y contacto</th><th>Dirección</th><th>Detalle</th><th>Pago</th><th>Estado</th><th>Acción</th></tr></thead><tbody>{orders.map((order) => { const payment = paymentInfo(order); return <tr key={order.id}><td>#{order.id}<br /><span className="dashboard-muted">${order.total}</span></td><td><strong>{order.user?.name || 'Cliente'}</strong><br /><span className="dashboard-muted">{order.user?.phone || 'Teléfono no registrado'}</span><br /><span className="dashboard-muted">{order.user?.email || ''}</span></td><td>{order.address?.full_address || 'Dirección no registrada'}<br /><span className="dashboard-muted">{order.address?.city || ''}</span></td><td><details className="dashboard-recipe"><summary>{order.items?.length || 0} producto(s)</summary><ul>{order.items?.map((item) => <li key={item.id}>{item.quantity} x {item.product?.name || 'Producto'} (${item.unit_price})</li>)}</ul></details></td><td><span className={`dashboard-alert ${payment.className}`}>{payment.label}</span><br /><span className="dashboard-muted">{payment.detail}</span></td><td><span className="status">Listo para entrega</span></td><td><button type="button" disabled={loadingId === order.id} onClick={() => confirmDelivery(order)}>{loadingId === order.id ? 'Confirmando...' : 'Marcar entregado'}</button></td></tr>; })}</tbody></table></div>}
80:         </section>
81: 
82:         <section className="dashboard-panel dashboard-section">
83:           <h2>Seguimiento de entrega</h2>
84:           <p className="dashboard-muted">Los cambios de estado quedan registrados en el historial del pedido. El sistema actual usa <strong>shipped</strong> como pedido listo/en ruta y <strong>delivered</strong> como entrega confirmada.</p>
85:           {lastDelivered && <p className="dashboard-muted">Última entrega confirmada: pedido #{lastDelivered.id}, <time dateTime={lastDelivered.at}>{new Date(lastDelivered.at).toLocaleString()}</time>.</p>}
86:         </section>
87:       </div>
88:     </section>
89:   );
90: }
</file>

