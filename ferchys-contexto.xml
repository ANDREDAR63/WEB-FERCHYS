  9: const Navbar = () => {
 10:   const navigate = useNavigate();
 11:   const { user, logout } = useAuth();
 12:   const [scrolled, setScrolled] = useState(false);
 13:   const [menuOpen, setMenuOpen] = useState(false);
 14:   const [cartOpen, setCartOpen] = useState(false);
 15:   const [cartItems, setCartItems] = useState(() => {
 16:     if (typeof window === 'undefined') return [];
 17:     const guardado = localStorage.getItem('ferchys-carrito');
 18:     return guardado ? JSON.parse(guardado) : [];
 19:   });
 20: 
 21:   useEffect(() => {
 22:     const handleScroll = () => setScrolled(window.scrollY > 40);
 23:     window.addEventListener('scroll', handleScroll);
 24: 
 25:     const syncCart = () => {
 26:       if (!localStorage.getItem('ferchys-token')) {
 27:         setCartItems(readGuestCart());
 28:         return;
 29:       }
