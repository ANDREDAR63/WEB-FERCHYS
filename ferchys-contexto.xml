<file path="frontend/src/components/catalogo/ProductPreview.jsx">
 1: import './catalogo.css';
 2: 
 3: const imagenes = import.meta.glob('../../assets/*', { eager: true });
 4: const imagenesPorProducto = {
 5:   Suspiros: 'favicon-rosa',
 6:   Alfajores: 'favicon-rosa',
 7:   'Cheesecake de limón': 'cheesecake_limon',
 8:   'Cheesecake de maracuyá': 'cheesecake_maracuya',
 9:   'Cheesecake de chocolate': 'cheesecake_chocolate',
10:   'Cheesecake de arándano': 'cheesecake_arandano',
11:   'Cheesecake de papayuela': 'cheesecake_papayuela',
12:   'Cheesecake de red velvet': 'cheesecake_redvelvet',
13:   'Refractaria familiar de cheesecake': 'cheesecakes-grandes',
14: };
15: 
16: function obtenerImagen(product) {
17:   if (product.image_url) return product.image_url;
18:   const nombreArchivo = imagenesPorProducto[product.name] || 'favicon-rosa';
19:   const ruta = Object.keys(imagenes).find((key) => key.includes(nombreArchivo));
20:   return ruta ? imagenes[ruta].default : '';
21: }
22: 
23: export default function ProductPreview({ product, quantity, open, onToggle }) {
24:   const name = product?.name || 'Producto';
25:   const price = Number(product?.price || 0);
26: 
27:   return (
28:     <span className={`product-preview ${open ? 'product-preview--open' : ''}`}>
29:       <button type="button" className="product-preview__trigger" onClick={onToggle} aria-expanded={open}>
30:         {name} x{quantity}
31:       </button>
32:       <span className="card-producto product-preview__card" role="dialog" aria-label={`Información de ${name}`}>
33:         <span className="card-producto__imagen product-preview__image-wrap"><img src={obtenerImagen(product)} alt={name} className="product-preview__image" /></span>
34:         <span className="card-cuerpo product-preview__content">
35:           <strong className="card-producto__nombre">{name}</strong>
36:           <span className="card-producto__desc">{product?.description || 'Sin descripción disponible.'}</span>
37:           <span className="product-preview__price">${price.toLocaleString()}</span>
38:         </span>
39:       </span>
40:     </span>
41:   );
42: }
</file>

