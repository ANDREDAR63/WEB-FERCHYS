175: 
176:   const cambiarCantidad = (producto, delta) => {
177:     const productoExistente = carritoActual.find((item) => item.product_id === producto.id);
178:     const nuevaCantidad = productoExistente ? itemQuantity(productoExistente) + delta : 1;
179:     actualizarCarrito(producto, Math.max(0, nuevaCantidad));
180:   };
181: 
182:   const inputCantidad = (producto, valor) => {
183:     const cantidad = Number(valor);
184:     actualizarCarrito(producto, Number.isNaN(cantidad) ? 0 : Math.max(0, cantidad));
185:   };
186: 
187:   return (
188:     <section className="catalogo section-padding" id="catalogo">
189:       <div className="container">
190:         <h2>Nuestros Postres</h2>
191:         <p className="catalogo__intro">
192:           Cada postre es preparado con ingredientes frescos y mucho amor.
193:           Haz tu pedido personalizado con anticipación.
194:         </p>
195: 
196:         {/* Filtros */}
197:         <div className="catalogo__filtros">
198:           {categorias.map(cat => (
199:             <button
200:               key={cat.id}
201:               className={`catalogo__filtro ${activo === cat.id ? 'catalogo__filtro--activo' : ''}`}
202:               onClick={() => setActivo(cat.id)}
203:             >
204:               {cat.label}
205:             </button>
206:           ))}
207:         </div>
208: 
209:         {/* Grid de productos */}
210:         <div className="catalogo__grid">
211:           {filtrados.map(producto => {
212:             const itemCarrito = carritoActual.find((item) => item.product_id === producto.id);
213:             const cantidadActual = itemCarrito ? itemQuantity(itemCarrito) : 0;
214: 
215:             return (
216:               <article key={producto.id} className="card-producto">
217:                 {producto.badge && (
218:                   <span className="card-producto__badge">{producto.badge}</span>
219:                 )}
220:                 <div className="card-producto__imagen">
221:                   <img src={producto.img} alt={producto.nombre} className="card-producto__imagen"/>
222:                 </div>
223:                 <div className="card-cuerpo">
224:                   <h3 className="card-producto__nombre">{producto.nombre}</h3>
225:                   <p className="card-producto__desc">{producto.descripcion}</p>
226:                   <div className="card-producto__footer">
227:                     <span className="card-precio">{producto.precio}</span>
228:                     <div className="card-producto__acciones">
229:                       {cantidadActual > 0 ? (
230:                         <div className="card-producto__contador">
231:                           <button
232:                             type="button"
233:                             className="card-producto__contador-btn"
234:                             onClick={() => cambiarCantidad(producto, -1)}
235:                           >
236:                             −
237:                           </button>
238:                           <input
239:                             type="number"
240:                             min="0"
241:                             value={cantidadActual}
242:                             onChange={(e) => inputCantidad(producto, e.target.value)}
243:                             className="card-producto__cantidad"
244:                           />
245:                           <button
246:                             type="button"
247:                             className="card-producto__contador-btn"
248:                             onClick={() => cambiarCantidad(producto, 1)}
249:                           >
250:                             +
251:                           </button>
252:                         </div>
253:                       ) : (
254:                         <button
255:                           type="button"
256:                           className="card-producto__btn"
257:                           onClick={() => agregarAlCarrito(producto)}
258:                         >
259:                           <span>Agregar al carrito</span>
260:                         </button>
261:                       )}
262:                     </div>
263:                   </div>
264:                 </div>
265:               </article>
266:             );
267:           })}
268:         </div>
269: 
270:         {error && <p role="alert">{error}</p>}
271:         {carritoActual.length > 0 && (
272:           <div className="catalogo__resumen">
273:             <div className="catalogo__resumen-info">
274:               <strong>{carritoActual.reduce((total, item) => total + itemQuantity(item), 0)} productos</strong>
275:               <span>en tu selección</span>
276:             </div>
277:             <button type="button" className="catalogo__resumen-btn" onClick={() => navigate('/carrito')}>
278:               Ir al carrito
279:             </button>
280:           </div>
281:         )}
282:       </div>
283:     </section>
