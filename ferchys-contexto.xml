 1: <?php
 2: 
 3: namespace App\Http\Controllers\Api;
 4: 
 5: use App\Http\Controllers\Controller;
 6: use App\Models\Address;
 7: use App\Models\User;
 8: use Illuminate\Http\Request;
 9: use Illuminate\Support\Facades\DB;
10: use Illuminate\Support\Facades\Hash;
11: use Illuminate\Validation\ValidationException;
12: 
13: class AuthController extends Controller
14: {
15:     public function register(Request $request)
16:     {
17:         $validated = $request->validate([
18:             'name' => 'required|string|max:255',
19:             'email' => 'required|string|email|max:255|unique:users',
20:             'password' => 'required|string|min:8|confirmed',
21:             'phone' => 'nullable|string|max:20',
22:             'address' => 'required|string|max:255',
23:         ]);
24: 
25:         $user = DB::transaction(function () use ($validated) {
26:             $user = User::create([
27:                 'name' => $validated['name'],
28:                 'email' => $validated['email'],
29:                 'password' => Hash::make($validated['password']),
30:                 'phone' => $validated['phone'] ?? null,
31:                 'role' => 'client',
32:             ]);
33: 
34:             Address::create([
35:                 'user_id' => $user->id,
36:                 'full_address' => $validated['address'],
37:                 'is_default' => true,
38:             ]);
39: 
40:             return $user;
41:         });
42: 
43:         return response()->json([
44:             'user' => $user,
45:         ], 201);
46:     }
47: 
48:     public function login(Request $request)
49:     {
50:         $validated = $request->validate([
51:             'email' => 'required|string|email',
52:             'password' => 'required|string',
53:         ]);
54: 
55:         $user = User::where('email', $validated['email'])->first();
56: 
57:         if (! $user || ! Hash::check($validated['password'], $user->password)) {
58:             throw ValidationException::withMessages([
59:                 'email' => ['Las credenciales proporcionadas son incorrectas.'],
60:             ]);
61:         }
62: 
63:         $token = $user->createToken('auth_token')->plainTextToken;
64: 
65:         return response()->json([
66:             'user' => $user,
67:             'token' => $token,
68:         ]);
69:     }
70: 
71:     public function logout(Request $request)
72:     {
73:         $request->user()->currentAccessToken()->delete();
74: 
75:         return response()->json(['message' => 'Sesión cerrada correctamente.']);
76:     }
77: 
78:     public function me(Request $request)
79:     {
80:         return response()->json($request->user());
