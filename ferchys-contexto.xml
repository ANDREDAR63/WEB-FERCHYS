143:     if (!user) {
144:       const carrito = upsertGuestItem(carritoActual, producto, cantidad);
145:       setCarritoActual(carrito);
146:       writeGuestCart(carrito);
147:       window.dispatchEvent(new Event('ferchys-carrito-cambiado'));
148:       return;
149:     }
150:     setCarritoActual((prevCarrito) => {
151:       const productoExistente = prevCarrito.find((item) => item.product_id === producto.id);
152:       if (cantidad === 0 && productoExistente) {
153:         apiRequest(`/cart/items/${productoExistente.id}`, { method: 'DELETE' })
154:           .then(() => apiRequest('/cart'))
155:           .then((cart) => setCarritoActual(cart.items || []))
156:           .catch((error) => setError(error.message));
157:         return prevCarrito;
158:       }
159:       const request = productoExistente
160:         ? apiRequest(`/cart/items/${productoExistente.id}`, { method: 'PUT', body: JSON.stringify({ quantity: cantidad }) })
161:         : apiRequest('/cart/items', { method: 'POST', body: JSON.stringify({ product_id: producto.id, quantity: cantidad }) });
162:       request.then(() => apiRequest('/cart')).then((cart) => {
163:         setCarritoActual(cart.items || []);
164:         window.dispatchEvent(new Event('ferchys-carrito-cambiado'));
165:       }).catch((error) => setError(error.message));
166:       return prevCarrito;
167:     });
168:   };
