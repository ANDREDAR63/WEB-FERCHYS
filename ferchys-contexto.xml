<file path="backend/app/Http/Controllers/Api/CartController.php">
 1: <?php
 2: 
 3: namespace App\Http\Controllers\Api;
 4: 
 5: use App\Http\Controllers\Controller;
 6: use App\Models\Cart;
 7: use App\Models\CartItem;
 8: use Illuminate\Http\Request;
 9: 
10: class CartController extends Controller
11: {
12:     public function index(Request $request)
13:     {
14:         $cart = $this->currentCart($request);
15: 
16:         return $cart->load('items.product');
17:     }
18: 
19:     public function addItem(Request $request)
20:     {
21:         $validated = $request->validate([
22:             'product_id' => 'required|exists:products,id',
23:             'quantity' => 'required|integer|min:1',
24:         ]);
25: 
26:         $cart = $this->currentCart($request);
27: 
28:         $item = CartItem::where('cart_id', $cart->id)
29:             ->where('product_id', $validated['product_id'])
30:             ->first();
31: 
32:         if ($item) {
33:             $item->increment('quantity', $validated['quantity']);
34:         } else {
35:             $item = CartItem::create([
36:                 'cart_id' => $cart->id,
37:                 'product_id' => $validated['product_id'],
38:                 'quantity' => $validated['quantity'],
39:             ]);
40:         }
41: 
42:         return response()->json($item->load('product'), 201);
43:     }
44: 
45:     public function updateItem(Request $request, CartItem $cartItem)
46:     {
47:         $validated = $request->validate([
48:             'quantity' => 'required|integer|min:1',
49:         ]);
50: 
51:         $cartItem->update($validated);
52: 
53:         return response()->json($cartItem->load('product'));
54:     }
55: 
56:     public function removeItem(CartItem $cartItem)
57:     {
58:         $cartItem->delete();
59: 
60:         return response()->json(null, 204);
61:     }
62: 
63:     private function currentCart(Request $request): Cart
64:     {
65:         return Cart::firstOrCreate(['user_id' => $request->user()->id]);
66:     }
67: }
</file>

