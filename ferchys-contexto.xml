114: 
115:       {/* <div className="add-product-box">
116:         <h3>Selecciona un producto para agregar:</h3>
117:         <form onSubmit={agregarProducto} className="add-product-form">
118:           <select value={productId} onChange={(event) => setProductId(event.target.value)} className="product-select">
