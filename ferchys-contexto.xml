<file path="frontend/src/context/AuthContext.jsx">
 1: import { useEffect, useState } from 'react';
 2: import { apiRequest } from '../services/api';
 3: import { AuthContext } from './auth-context';
 4: 
 5: export function AuthProvider({ children }) {
 6:   const [user, setUser] = useState(() => JSON.parse(localStorage.getItem('ferchys-user') || 'null'));
 7:   const [loading, setLoading] = useState(Boolean(localStorage.getItem('ferchys-token')));
 8: 
 9:   useEffect(() => {
10:     if (!localStorage.getItem('ferchys-token')) return;
11:     apiRequest('/me')
12:       .then((currentUser) => {
13:         setUser(currentUser);
14:         localStorage.setItem('ferchys-user', JSON.stringify(currentUser));
15:       })
16:       .catch(() => logout())
17:       .finally(() => setLoading(false));
18:   }, []);
19: 
20:   async function login(email, password) {
21:     const result = await apiRequest('/login', { method: 'POST', body: JSON.stringify({ email, password }) });
22:     localStorage.setItem('ferchys-token', result.token);
23:     localStorage.setItem('ferchys-user', JSON.stringify(result.user));
24:     setUser(result.user);
25:     return result.user;
26:   }
27: 
28:   async function register(data) {
29:     const result = await apiRequest('/register', { method: 'POST', body: JSON.stringify(data) });
30:     return result.user;
31:   }
32: 
33:   async function logout() {
34:     if (localStorage.getItem('ferchys-token')) {
35:       await apiRequest('/logout', { method: 'POST' }).catch(() => null);
36:     }
37:     localStorage.removeItem('ferchys-token');
38:     localStorage.removeItem('ferchys-user');
39:     setUser(null);
40:   }
41: 
42:   function clearSession() {
43:     localStorage.removeItem('ferchys-token');
44:     localStorage.removeItem('ferchys-user');
45:     setUser(null);
46:   }
47: 
48:   return <AuthContext.Provider value={{ user, loading, login, register, logout, clearSession }}>{children}</AuthContext.Provider>;
49: }
</file>

