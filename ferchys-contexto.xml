<file path="frontend/src/components/navbar/NavbarClient.jsx">
 1: import { useEffect, useState } from 'react';
 2: import { NavLink, useNavigate } from 'react-router-dom';
 3: import { apiRequest } from '../../services/api';
 4: import { useAuth } from '../../context/auth';
 5: import { itemQuantity, readGuestCart } from '../../services/guestCart';
 6: import './navbar.css';
 7: import logo from '../../assets/logo.ico';
 8: 
 9: export default function NavbarClient() {
10:   const navigate = useNavigate();
11:   const { logout } = useAuth();
12:   const [scrolled, setScrolled] = useState(false);
13:   const [menuOpen, setMenuOpen] = useState(false);
14:   const [cartOpen, setCartOpen] = useState(false);
15:   const [cartItems, setCartItems] = useState(() => readGuestCart());
16: 
17:   useEffect(() => {
18:     const handleScroll = () => setScrolled(window.scrollY > 40);
19:     const syncCart = () => {
20:       if (!localStorage.getItem('ferchys-token')) {
21:         setCartItems(readGuestCart());
22:         return;
23:       }
24:       apiRequest('/cart').then((cart) => setCartItems(cart.items || [])).catch(() => setCartItems([]));
25:     };
26: 
27:     window.addEventListener('scroll', handleScroll);
28:     syncCart();
29:     window.addEventListener('ferchys-carrito-cambiado', syncCart);
30:     window.addEventListener('storage', syncCart);
31: 
32:     return () => {
33:       window.removeEventListener('scroll', handleScroll);
34:       window.removeEventListener('ferchys-carrito-cambiado', syncCart);
35:       window.removeEventListener('storage', syncCart);
36:     };
37:   }, []);
38: 
39:   const totalProductos = cartItems.reduce((total, item) => total + itemQuantity(item), 0);
40: 
41:   const manejarCierreSesion = async () => {
42:     setMenuOpen(false);
43:     setCartOpen(false);
44:     await logout();
45:     navigate('/');
46:   };
47: 
48:   const cerrarMenu = () => setMenuOpen(false);
49: 
50:   return (
51:     <nav className={`navbar ${scrolled ? 'navbar--scrolled' : ''}`}>
52:       <div className="navbar__container">
53:         <NavLink to="/catalogo" className="navbar__logo" onClick={cerrarMenu}>
54:           <img src={logo} alt="Logo Ferchy" className="navbar__logo-icon" />
55:           <span className="navbar__logo-text">Ferchy<span>'</span>s Postres</span>
56:         </NavLink>
57: 
58:         <ul className={`navbar__links ${menuOpen ? 'navbar__links--open' : ''}`}>
59:           <li><NavLink to="/catalogo" className={({ isActive }) => `navbar__link ${isActive ? 'navbar__link--active' : ''}`} onClick={cerrarMenu}>Catálogo</NavLink></li>
60:           <li><NavLink to="/dashboard/cliente" end className={({ isActive }) => `navbar__link ${isActive ? 'navbar__link--active' : ''}`} onClick={cerrarMenu}>Mis compras</NavLink></li>
61:           <li className="navbar__cart-wrapper">
62:             <button type="button" className="navbar__cart" onClick={() => {
63:               setMenuOpen(false);
64:               const isMobile = window.innerWidth <= 768;
65:               if (isMobile) {
66:                 setCartOpen(false);
67:                 navigate('/carrito');
68:                 return;
69:               }
70:               setCartOpen((prev) => !prev);
71:             }} aria-label="Carrito de compras">
72:               Carrito 🛒 {totalProductos > 0 && <span>({totalProductos})</span>}
73:             </button>
74:             {cartOpen && (
75:               <div className="navbar__cart-panel">
76:                 <div className="navbar__cart-panel-header"><strong>Tu carrito</strong></div>
77:                 {cartItems.length === 0 ? <p className="navbar__cart-empty">Aún no tienes productos agregados.</p> : (
78:                   <div className="navbar__cart-items">
79:                     {cartItems.map((item) => <div key={item.id} className="navbar__cart-item"><span>{item.product?.name || item.nombre || 'Producto'}</span><strong>x{itemQuantity(item)}</strong></div>)}
80:                     <div className="navbar__cart-summary"><span>{totalProductos} productos</span></div>
81:                   </div>
82:                 )}
83:                 <div className="navbar__cart-actions"><NavLink to="/carrito" className="navbar__cart-link" onClick={() => setCartOpen(false)}>Ir al carrito de compras</NavLink></div>
84:               </div>
85:             )}
86:           </li>
87:           <li><button type="button" className="navbar__logout" onClick={manejarCierreSesion}>Cerrar sesión</button></li>
88:         </ul>
89: 
90:         <button type="button" className={`navbar__hamburger ${menuOpen ? 'navbar__hamburger--open' : ''}`} onClick={() => setMenuOpen((prev) => !prev)} aria-label="Abrir menú">
91:           <span /><span /><span />
92:         </button>
93:       </div>
94:     </nav>
95:   );
96: }
</file>

