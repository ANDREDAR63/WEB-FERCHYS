131:             <div className="item-controls"><button type="button" onClick={() => cambiarCantidad(item, itemQuantity(item) - 1)}>-</button><span>{itemQuantity(item)}</span><button type="button" onClick={() => cambiarCantidad(item, itemQuantity(item) + 1)}>+</button></div>
132:             <div className="item-subtotal"><strong>${(Number(item.product?.price || 0) * itemQuantity(item)).toLocaleString()}</strong></div>
133:             <button type="button" className="delete-btn" onClick={() => cambiarCantidad(item, 0)}>Eliminar</button>
