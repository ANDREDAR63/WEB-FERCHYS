  6: import postre2 from '../../assets/cheesecake_baileys.png';
  7: import postre3 from '../../assets/cheesecake_chocolate.png';
  8: 
  9: export default function PasswordRecovery() {
 10:   const [correo, setCorreo] = useState('');
 11:   const [errorMensaje, setErrorMensaje] = useState('');
 12:   const [correoEnviado, setCorreoEnviado] = useState(false);
 13:   const [imagenActual, setImagenActual] = useState(0);
 14: 
 15:   const imagenes = [postre1, postre2, postre3];
 16: 
 17:   useEffect(() => {
 18:     const intervalo = setInterval(() => {
 19:       setImagenActual((prev) => (prev + 1) % imagenes.length);
 20:     }, 3500);
 21:     return () => clearInterval(intervalo);
 22:   }, [imagenes.length]);
 23: 
 24:   const correosExistentes = ['ferchys@postres.com', 'admin@correo.com', 'cliente@prueba.com'];
 25: 
 26:   const manejarRecuperacion = (e) => {
 27:     e.preventDefault();
 28:     setErrorMensaje('');
 29: 
 30:     if (!correosExistentes.includes(correo.trim().toLowerCase())) {
 31:       setErrorMensaje('⚠️ No encontramos ninguna cuenta asociada a este correo electrónico.');
 32:       return;
 33:     }
 34: 
 35:     setCorreoEnviado(true);
 36:   };
 37: 
 38:   return (
 39:     <div className="recuperar-pagina-container" style={{ width: '100%', display: 'flex', justifyContent: 'center' }}>
 40:       
 41:       {/* ⚠️ FORZAMOS EL ANCHO AQUÍ EN LÍNEA PARA ANULAR EL ALTO/ANCHO QUE LE IMPONE EL LAYOUT PADRE */}
 42:       <div 
 43:         className="recuperar-card" 
 44:         style={{ 
 45:           width: '90vw', 
 46:           maxWidth: '850px', 
 47:           minHeight: '480px', 
 48:           display: 'flex', 
 49:           flexDirection: 'row',
 50:           borderRadius: '24px',
 51:           overflow: 'hidden',
 52:           backgroundColor: '#ffffff',
 53:           boxShadow: '0 15px 35px rgba(128, 79, 93, 0.15)'
 54:         }}
 55:       >
 56:         
 57:         {/* COLUMNA IZQUIERDA: CARRUSEL */}
 58:         <div className="recuperar-carrusel" style={{ flex: '1', width: '50%', position: 'relative', height: '100%', minHeight: '480px' }}>
 59:           {imagenes.map((img, index) => (
 60:             <div
 61:               key={index}
 62:               className={`carrusel-slide ${index === imagenActual ? 'active' : ''}`}
 63:               style={{ backgroundImage: `url(${img})` }}
 64:             />
 65:           ))}
 66:           <div className="carrusel-overlay">
 67:             <h3>Ferchy's Postres</h3>
 68:             <p>Endulzando tus mejores momentos</p>
 69:           </div>
 70:           <div className="carrusel-dots">
 71:             {imagenes.map((_, index) => (
 72:               <span
 73:                 key={index}
 74:                 className={`dot ${index === imagenActual ? 'active' : ''}`}
 75:                 onClick={() => setImagenActual(index)}
 76:               />
 77:             ))}
 78:           </div>
 79:         </div>
 80: 
 81:         {/* COLUMNA DERECHA: FORMULARIO */}
 82:         <div className="recuperar-contenido" style={{ flex: '1', width: '50%', padding: '2.5rem 2rem' }}>
 83:           {correoEnviado ? (
 84:             <div className="mensaje-exito">
 85:               <h2>¡Revisa tu bandeja! 📩</h2>
 86:               <p>Hemos enviado un enlace de recuperación a <strong>{correo}</strong>.</p>
 87:               <p className="texto-secundario">
 88:                 Sigue las instrucciones del correo para restablecer tu contraseña.
 89:               </p>
 90: 
 91:               <div className="isla-spam">
 92:                 <span className="isla-icon">💡</span>
 93:                 <strong>¿No ves el mensaje en tu bandeja?</strong>
 94:                 <p>
 95:                   Revisa tu carpeta de <strong>Correo no deseado (Spam)</strong> o promociones.
 96:                 </p>
 97:               </div>
 98: 
 99:               <NavLink to="/login" className="btn-primario">
100:                 Volver a Iniciar Sesión
101:               </NavLink>
102:             </div>
103:           ) : (
104:             <>
105:               <h2>Recuperar Contraseña</h2>
106:               <p className="subtitulo">
107:                 Ingresa tu correo electrónico asociado para enviarte las instrucciones.
108:               </p>
109: 
110:               {errorMensaje && (
111:                 <div className="mensaje-error">
112:                   {errorMensaje}
113:                 </div>
114:               )}
115: 
116:               <form onSubmit={manejarRecuperacion}>
117:                 <div className="campo-grupo">
