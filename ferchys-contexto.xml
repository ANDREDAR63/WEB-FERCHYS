171:     const productoExistente = carritoActual.find((item) => item.product_id === producto.id);
172:     const nuevaCantidad = productoExistente ? itemQuantity(productoExistente) + 1 : 1;
173:     actualizarCarrito(producto, nuevaCantidad);
