 61:       setItems(nextItems);
 62:       writeGuestCart(nextItems);
 63:       window.dispatchEvent(new Event('ferchys-carrito-cambiado'));
 64:       return;
 65:     }
 66:     const request = quantity > 0
 67:       ? apiRequest(`/cart/items/${item.id}`, { method: 'PUT', body: JSON.stringify({ quantity }) })
 68:       : apiRequest(`/cart/items/${item.id}`, { method: 'DELETE' });
 69:     request.then(refreshCart).catch((requestError) => setError(requestError.message));
 70:   };
 71: 
 72:   const totalPagar = items.reduce((total, item) => total + Number(item.product?.price || 0) * itemQuantity(item), 0);
 73: 
 74:   const handleSubmit = (event) => {
