<file path="frontend/src/services/guestCart.js">
 1: const GUEST_CART_KEY = 'ferchys-carrito';
 2: 
 3: export function readGuestCart() {
 4:   try {
 5:     return JSON.parse(localStorage.getItem(GUEST_CART_KEY) || '[]');
 6:   } catch {
 7:     return [];
 8:   }
 9: }
10: 
11: export function writeGuestCart(items) {
12:   localStorage.setItem(GUEST_CART_KEY, JSON.stringify(items));
13: }
14: 
15: export function itemQuantity(item) {
16:   return Number(item?.quantity ?? item?.cantidad ?? 0);
17: }
18: 
19: export function upsertGuestItem(items, product, quantity) {
20:   const existingItem = items.find((item) => item.product_id === product.id);
21:   if (quantity <= 0) return items.filter((item) => item.product_id !== product.id);
22:   if (existingItem) {
23:     return items.map((item) => item.product_id === product.id ? { ...item, quantity, cantidad: quantity } : item);
24:   }
25:   return [...items, { id: `guest-${product.id}`, product_id: product.id, quantity, cantidad: quantity, product }];
26: }
</file>

