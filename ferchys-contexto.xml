  4: import { useAuth } from '../../context/auth';
  5: 
  6: export default function Registration() {
  7:   const [formData, setFormData] = useState({
  8:     nombre: '',
  9:     telefono: '',
 10:     direccion: '',
 11:     correo: '',
 12:     clave: '',
 13:     confirmarClave: '',
 14:   });
 15:   const [registradoExitoso, setRegistradoExitoso] = useState(false);
 16:   const [errorMensaje, setErrorMensaje] = useState('');
 17:   const [enviando, setEnviando] = useState(false);
 18:   const { register } = useAuth();
 19:   const location = useLocation();
 20:   const returnPath = location.state?.from || '/';
 21: 
 22:   const cerrarError = () => {
 23:     setErrorMensaje('');
 24:   };
 25: 
 26:   const handleChange = (e) => {
 27:     const { name, value } = e.target;
 28: 
 29:     if (name === 'telefono') {
 30:       setFormData((prev) => ({ ...prev, [name]: value.replace(/\D/g, '') }));
 31:       return;
 32:     }
 33: 
 34:     if (name === 'nombre') {
 35:       setFormData((prev) => ({ ...prev, [name]: value.replace(/[^a-zA-ZáéíóúÁÉÍÓÚñÑ\s]/g, '') }));
 36:       return;
 37:     }
 38: 
 39:     setFormData((prev) => ({ ...prev, [name]: value }));
 40:   };
 41: 
 42:   const manejarRegistro = (e) => {
 43:     e.preventDefault();
 44:     setErrorMensaje('');
 45: 
 46:     const { nombre, telefono, direccion, correo, clave, confirmarClave } = formData;
 47: 
 48:     // Expresión regular para validar seguridad de la contraseña
 49:     const regexPassword = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&#._-])[A-Za-z\d@$!%*?&#._-]{8,}$/;
 50: 
 51:     const validaciones = [
 52:       {
 53:         condicion: !nombre.trim() || !telefono.trim() || !direccion.trim() || !correo.trim() || !clave.trim() || !confirmarClave.trim(),
 54:         mensaje: 'Todos los campos son obligatorios.',
 55:       },
 56:       {
 57:         condicion: !regexPassword.test(clave),
 58:         mensaje: 'La contraseña debe tener al menos 8 caracteres, incluyendo una mayúscula, una minúscula, un número y un símbolo especial.',
 59:       },
 60:       {
 61:         condicion: clave !== confirmarClave,
 62:         mensaje: 'Las contraseñas no coinciden. Por favor, revísalas.',
 63:       },
 64:     ];
 65: 
 66:     const error = validaciones.find((item) => item.condicion);
 67: 
 68:     if (error) {
 69:       setErrorMensaje(error.mensaje);
 70:       return;
 71:     }
 72: 
 73:     setEnviando(true);
 74:     register({
 75:       name: nombre.trim(),
 76:       email: correo.trim().toLowerCase(),
 77:       password: clave,
 78:       password_confirmation: confirmarClave,
 79:       phone: telefono,
 80:       address: direccion.trim(),
 81:     })
 82:       .then(() => setRegistradoExitoso(true))
 83:       .catch((error) => setErrorMensaje(error.message))
 84:       .finally(() => setEnviando(false));
 85:   };
 86: 
 87:   return (
 88:     <section className="acceso-usuarios">
 89:       {errorMensaje && (
 90:         <div className="mensaje-error-splash" role="alert">
 91:           <div className="mensaje-error-splash__card">
 92:             <button
 93:               type="button"
 94:               className="mensaje-error-splash__close"
 95:               onClick={cerrarError}
 96:               aria-label="Cerrar mensaje de error"
 97:             >
 98:               ×
 99:             </button>
100:             <h3>¡Ups!</h3>
101:             <p>{errorMensaje}</p>
102:           </div>
103:         </div>
104:       )}
105: 
106:       {registradoExitoso ? (
107:         <div className="mensaje-exito">
108:           <h2>¡Felicidades!</h2>
109:           <p>Te has registrado correctamente en Ferchy's Postres.</p>
110:           <p className="mensaje-exito__texto">Ya puedes disfrutar de nuestros dulces momentos.</p>
111: 
112:           <NavLink to="/login" state={{ from: returnPath }} className="btn btn-primario">
113:             Iniciar Sesión
114:           </NavLink>
115:         </div>
116:       ) : (
117:         <>
118:           <h2>Crea tu cuenta en Ferchy's</h2>
119: 
120:           <form onSubmit={manejarRegistro}>
121:             <label htmlFor="nombre">
122:               Nombre completo: <span className="campo-obligatorio">*</span>
123:             </label>
124:             <input
125:               type="text"
126:               id="nombre"
127:               name="nombre"
128:               placeholder="Tu nombre y apellido"
129:               value={formData.nombre}
130:               onChange={handleChange}
131:               required
132:             />
133: 
134:             <label htmlFor="telefono">
135:               Número de contacto: <span className="campo-obligatorio">*</span>
136:             </label>
137:             <input
138:               type="text"
139:               id="telefono"
140:               name="telefono"
141:               placeholder="Ej: 3001234567"
142:               value={formData.telefono}
143:               onChange={handleChange}
144:               maxLength={10}
145:               required
146:             />
147: 
148:             <label htmlFor="direccion">
149:               Dirección de entrega: <span className="campo-obligatorio">*</span>
150:             </label>
151:             <input
152:               type="text"
153:               id="direccion"
154:               name="direccion"
155:               placeholder="Calle, número, barrio o apartamento"
156:               value={formData.direccion}
157:               onChange={handleChange}
158:               required
159:             />
160: 
161:             <label htmlFor="correo">
162:               Correo electrónico: <span className="campo-obligatorio">*</span>
163:             </label>
164:             <input
165:               type="email"
166:               id="correo"
167:               name="correo"
