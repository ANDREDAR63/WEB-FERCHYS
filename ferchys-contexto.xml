<file path="frontend/src/services/api.js">
 1: const API_URL = (import.meta.env.VITE_API_URL || 'http://localhost:8000/api').replace(/\/$/, '');
 2: 
 3: export async function apiRequest(path, options = {}) {
 4:   const token = localStorage.getItem('ferchys-token');
 5:   const response = await fetch(`${API_URL}${path}`, {
 6:     ...options, 
 7:     headers: {
 8:       Accept: 'application/json',
 9:       'ngrok-skip-browser-warning': 'true',
10:       ...(options.body && !(options.headers && options.headers['Content-Type'] === false) ? { 'Content-Type': 'application/json' } : {}),
11:       ...(token ? { Authorization: `Bearer ${token}` } : {}),
12:       ...options.headers,
13:     },
14:   });
15: 
16:   if (response.status === 204) return null;
17: 
18:   const data = await response.json().catch(() => null);
19:   if (!response.ok) {
20:     throw new Error(data?.message || Object.values(data?.errors || {})[0]?.[0] || 'No se pudo completar la solicitud.');
21:   }
22: 
23:   return data;
24: }
</file>

<file path="backend/app/Http/Controllers/Api/OrderController.php">
  1: <?php
  2: 
  3: namespace App\Http\Controllers\Api;
  4: 
  5: use App\Http\Controllers\Controller;
  6: use App\Models\Cart;
  7: use App\Models\Order;
  8: use App\Models\OrderStatusHistory;
  9: use Illuminate\Http\Request;
 10: use Illuminate\Support\Facades\DB;
 11: use Illuminate\Validation\ValidationException;
 12: 
 13: class OrderController extends Controller
 14: {
 15:     public function index(Request $request)
 16:     {
 17:         $user = $request->user();
 18:         $query = Order::with('items.product.ingredients', 'statusHistory', 'address', 'user', 'payments.paymentMethod');
 19: 
 20:         if ($user->role === 'client') {
 21:             $query->where('user_id', $user->id);
 22:         } elseif ($user->role === 'cook') {
 23:             $query->where(function ($orders) {
 24:                 $orders->where('status', 'preparing')
 25:                     ->orWhere(function ($pendingOrders) {
 26:                         $pendingOrders->where('status', 'pending')
 27:                             ->whereHas('payments', fn ($payments) => $payments->where('status', 'approved'));
 28:                     });
 29:             });
 30:         } elseif ($user->role === 'courier') {
 31:             $query->where('status', 'shipped')
 32:                 ->where(function ($orders) use ($user) {
 33:                     $orders->where('courier_id', $user->id)->orWhereNull('courier_id');
 34:                 });
 35:         } elseif ($user->role !== 'admin') {
 36:             abort(403, 'Rol no autorizado.');
 37:         }
 38: 
 39:         return $query->latest()->get();
 40:     }
 41: 
 42:     public function show(Request $request, Order $order)
 43:     {
 44:         if ($request->user()->role === 'client') {
 45:             $this->authorizeOwner($request, $order);
 46:         }
 47: 
 48:         return $order->load('items.product.ingredients', 'payments', 'statusHistory', 'address');
 49:     }
 50: 
 51:     public function store(Request $request)
 52:     {
 53:         $validated = $request->validate([
 54:             'address_id' => 'required|exists:addresses,id',
 55:         ]);
 56: 
 57:         $cart = Cart::where('user_id', $request->user()->id)
 58:             ->with('items.product')
 59:             ->first();
 60: 
 61:         if (! $cart || $cart->items->isEmpty()) {
 62:             throw ValidationException::withMessages([
 63:                 'cart' => ['El carrito está vacío.'],
 64:             ]);
 65:         }
 66: 
 67:         $order = DB::transaction(function () use ($request, $cart, $validated) {
 68:             $total = $cart->items->sum(fn ($item) => $item->quantity * $item->product->price);
 69: 
 70:             $order = Order::create([
 71:                 'user_id' => $request->user()->id,
 72:                 'address_id' => $validated['address_id'],
 73:                 'total' => $total,
 74:                 'status' => 'pending',
 75:             ]);
 76: 
 77:             foreach ($cart->items as $item) {
 78:                 $order->items()->create([
 79:                     'product_id' => $item->product_id,
 80:                     'quantity' => $item->quantity,
 81:                     'unit_price' => $item->product->price,
 82:                 ]);
 83:             }
 84: 
 85:             OrderStatusHistory::create([
 86:                 'order_id' => $order->id,
 87:                 'previous_status' => null,
 88:                 'new_status' => 'pending',
 89:             ]);
 90: 
 91:             $cart->items()->delete();
 92: 
 93:             return $order;
 94:         });
 95: 
 96:         return response()->json($order->load('items.product'), 201);
 97:     }
 98: 
 99:     public function updateStatus(Request $request, Order $order)
100:     {
101:         $validated = $request->validate([
102:             'status' => 'required|in:pending,preparing,shipped,delivered,cancelled',
103:         ]);
104: 
105:         $role = $request->user()->role;
106:         $allowed = match ($role) {
107:             'cook' => ['pending' => ['preparing'], 'preparing' => ['shipped']],
108:             'courier' => ['shipped' => ['delivered']],
109:             'admin' => [
110:                 'pending' => ['preparing', 'cancelled'],
111:                 'preparing' => ['shipped', 'cancelled'],
112:                 'shipped' => ['delivered', 'cancelled'],
113:             ],
114:             default => [],
115:         };
116: 
117:         if (! in_array($validated['status'], $allowed[$order->status] ?? [], true)) {
118:             abort(422, 'La transición de estado no está permitida para este rol.');
119:         }
120: 
121:         DB::transaction(function () use ($order, $validated) {
122:             OrderStatusHistory::create([
123:                 'order_id' => $order->id,
124:                 'previous_status' => $order->status,
125:                 'new_status' => $validated['status'],
126:             ]);
127: 
128:             $order->update(['status' => $validated['status']]);
129:         });
130: 
131:         return response()->json($order->load('statusHistory'));
132:     }
133: 
134:     private function authorizeOwner(Request $request, Order $order): void
135:     {
136:         if ($order->user_id !== $request->user()->id && $request->user()->role !== 'admin') {
137:             abort(403, 'No tienes permiso para ver este pedido.');
138:         }
139:     }
140: }
</file>

